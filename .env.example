# Clés et jetons
GROQ_API_KEY=
DISCORD_TOKEN=

# Modèle : "groq:openai/gpt-oss-120b" (distant) ou "ollama:qwen3.5:0.8b" (local)
LLM_MODEL=groq:openai/gpt-oss-120b
SYSTEM_PROMPT_FILE=prompts/system_prompt.md
MAX_QUESTION_LENGTH=2000

# Documents (RAG)
CORPUS_DIR=corpus
INDEX_DIR=chroma_db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=50
PASSAGES_PER_SEARCH=3

# Base métier : les tickets du support, créée depuis le script au premier lancement
TICKETS_DB=data/tickets.db
TICKETS_SEED=data/tickets.sql

# Droits : les identifiants qui ont le rôle support, séparés par des virgules (ex. terminal,discord:123)
SUPPORT_USERS=terminal

# Coût : au plus N appels au modèle par question
MODEL_CALL_LIMIT=6

# Résumé des conversations longues
SUMMARY_TRIGGER_TOKENS=2000
MESSAGES_KEPT_AFTER_SUMMARY=4

# API web : la clé attendue dans l'en-tête X-API-Key, à choisir longue et aléatoire
API_KEY=
API_HOST=127.0.0.1
API_PORT=8000

# Terminal : off pour afficher la réponse d'un bloc
TERMINAL_STREAMING=on

# Traces LangSmith (facultatif)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=company-assistant
# Compte créé dans la région Europe seulement
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Évaluation
EVALUATION_CASES=evaluation/cases.json
EVALUATION_DATASET=company-assistant
